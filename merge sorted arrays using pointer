#include <iostream>
using namespace std;
void merge(int* arr1, int n1, int* arr2, int n2, int* res)
{
    int end1*=arr1+n1;
    int end2*=arr2+n2;
    while(arr1<end1 && arr2<end2)
    {
        if(*arr1<*arr2)
        {
            *res++ = *arr1++;
        }
        else
        {
            *res++ = *arr2++;
        }
    }
    while(arr1<end1)
    {
        *res++ = *arr1++;
    }
    while(arr2<end2)
    {
        *res++ = *arr2++;
    }
}
int main() 
{
    int arr1[] = {1, 3, 5, 7};
    int arr2[] = {2, 4, 6, 8};
    int n1 = sizeof(arr1) / sizeof(arr1[0]);
    int n2 = sizeof(arr2) / sizeof(arr2[0]);

    int result[n1 + n2];

    merge(arr1, n1, arr2, n2, result);

    printf("Merged Array: ");

    for (int i = 0; i < n1 + n2; i++)
        printf("%d ", result[i]);
    return 0;
}
